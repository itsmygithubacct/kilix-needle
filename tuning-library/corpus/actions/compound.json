{"action": "compound", "templates": [
 {"text": "split {side} and make it {layout}", "actions": [["open_pane", {"side": "$side"}], ["arrange_panes", {"layout": "$layout"}]]},
 {"text": "open a tab called {name} and make it {layout}", "actions": [["open_tab", {"name": "$name"}], ["arrange_panes", {"layout": "$layout"}]]},
 {"text": "go to tab {num} and make it {layout}", "actions": [["go_to_tab", {"tab": "$num"}], ["arrange_panes", {"layout": "$layout"}]]},
 {"text": "close tab {num} and go to tab {num2}", "actions": [["close_tab", {"tab": "$num"}], ["go_to_tab", {"tab": "$num2"}]]},
 {"text": "close the {side_adj} pane and make this one {direction}", "actions": [["close_pane", {"pane": "$side"}], ["resize_pane", {"direction": "$direction"}]]},
 {"text": "rename this tab to {name} then split {side}", "actions": [["rename_tab", {"name": "$name"}], ["open_pane", {"side": "$side"}]]},
 {"text": "go to the {side_adj} pane and run {command}", "actions": [["go_to_pane", {"pane": "$side"}], ["run_in_pane", {"pane": "current", "command": "$command"}]]},
 {"text": "split {side} and go to it", "actions": [["open_pane", {"side": "$side"}], ["go_to_pane", {"pane": "$side"}]]}
]}
